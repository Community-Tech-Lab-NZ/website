# Community Tech Lab — environment configuration
#
# Copy to .env.local for development. In production these are set in the Vercel
# project settings. Nothing here is a secret in this file; .env.local is
# gitignored and real values must never be committed.
#
# The site RUNS WITHOUT ANY OF THIS. Pages render, forms validate, and the
# submission route returns an honest "we could not save this" rather than
# pretending to succeed. That is deliberate, so the site can be developed and
# previewed without handing out credentials.

# ---------------------------------------------------------------------------
# Google: the applications Sheet and the Drive folders
# ---------------------------------------------------------------------------
# Setup, once, in the programme Google account:
#   1. console.cloud.google.com -> new project. No billing card needed; the
#      Sheets, Drive and Docs APIs are free at this volume.
#   2. Enable: Google Sheets API, Google Drive API, Google Docs API.
#   3. Create a service account, then a JSON key. Download it.
#   4. Create the Sheet with tabs named exactly:
#        Community   Developers   Questions   _raw
#   5. Create two Drive folders, e.g. "Applications" and "CVs".
#   6. Share the Sheet AND both folders with the service account's email
#      address, as Editor. This is the step people forget, and without it every
#      write returns 403.
#
# The Sheet and folders stay owned by the programme account. The service account
# only writes to them, so revoking access is a sharing change, not a redeploy.

GOOGLE_SERVICE_ACCOUNT_EMAIL="ctl-website@your-project.iam.gserviceaccount.com"

# From the JSON key's "private_key" field, including the BEGIN/END lines.
# Keep the literal \n sequences: the code converts them back to newlines.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# From the Sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=""

# From each folder URL: drive.google.com/drive/folders/<FOLDER_ID>
DRIVE_APPLICATIONS_FOLDER_ID=""
DRIVE_CVS_FOLDER_ID=""

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------
# Send-only. communitytechlab.co.nz currently has NO MX and NO TXT records, so
# Resend's SPF and DKIM records are a clean addition with nothing to conflict.
#
# DNS is at GoDaddy (nameservers ns71/ns72.domaincontrol.com), so the records go
# in GoDaddy's DNS panel. No nameserver move and no mailbox required: sending
# needs the domain verified, not an inbox.
RESEND_API_KEY=""

# Must be on the verified domain. Replies bounce, and the email says so.
EMAIL_FROM="Community Tech Lab <no-reply@communitytechlab.co.nz>"

# Where eligibility questions are forwarded. The programme Gmail is fine.
PROGRAMME_INBOX=""

# Confirmations stay off until DNS is live, so the code path can be deployed and
# tested before the domain is ready. Set to "true" to start sending.
SEND_CONFIRMATIONS="false"

# ---------------------------------------------------------------------------
# Site URL
# ---------------------------------------------------------------------------
# Optional. https://communitytechlab.co.nz is hardcoded as the production
# fallback in src/lib/site.ts, deliberately: a missed env var would otherwise
# publish localhost canonicals to the live site, which nobody notices until the
# site is not ranking.
#
# Set this only to override, for example staging on another domain.
# NEXT_PUBLIC_SITE_URL="https://communitytechlab.co.nz"

# ---------------------------------------------------------------------------
# Testing only
# ---------------------------------------------------------------------------
# Forces the application window state: before | open | closed.
#
# This exists so the end-to-end submission test can run against the real Sheet
# BEFORE 15 August. Without it the window guard rejects every test submission,
# and the first real proof the pipeline works would be the day it has to.
#
# MUST BE UNSET BEFORE LAUNCH. Left set, the form stays in that state forever.
# The server logs a warning on every request while it is active.
# APPLICATION_WINDOW_OVERRIDE="open"
